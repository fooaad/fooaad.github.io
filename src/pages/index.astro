---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile, intro, work, research, competitive, education, links } from '../data/site';
import { getPosts, formatDate } from '../lib';
import artLight from '../assets/pale-blue-dot-light.webp';
import artDark from '../assets/pale-blue-dot-dark.webp';

// One illustration per theme, with where Earth sits in each (% of width and height, for the ring).
const art = [
  { theme: 'light', img: artLight, earth: { x: 48.3, y: 50.8 } },
  { theme: 'dark', img: artDark, earth: { x: 48.9, y: 49.6 } },
];

const posts = await getPosts();
const shownLinks = links.filter((l) => l.url);
---

<Base>
  <!-- Originals (not recompressed) so they stay sharp; the page shows the one for the current theme.
       Only screens 1100px+ download them; smaller screens get a 1px placeholder and the panel stays hidden. -->
  <aside
    slot="aside"
    class="art"
    style={[
      `--ratio: ${artDark.width / artDark.height}`,
      ...art.map(({ theme, earth }) => `--${theme}-x: ${earth.x}%; --${theme}-y: ${earth.y}%`),
    ].join('; ')}
  >
    {art.map(({ theme, img }) => (
      <picture class={theme}>
        <source media="(min-width: 1100px)" srcset={img.src} />
        <img
          src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
          width={img.width}
          height={img.height}
          alt="Illustration after Voyager 1's Pale Blue Dot: Earth as a tiny blue speck in a faint beam of light"
        />
      </picture>
    ))}
    <span class="earth" aria-hidden="true"></span>
    <p class="earth-note">That's here. That's home. That's us.<span>Carl Sagan</span></p>
  </aside>

  <header>
    <div class="top">
      <h1>{profile.name}</h1>
      <ThemeToggle />
    </div>
    <p class="muted sub">@{profile.handle} · {profile.tagline} · {profile.location}</p>
  </header>

  {intro.map((p) => <p>{p}</p>)}

  <h2>Work</h2>
  <ul class="plain">
    {work.map((w) => (
      <li class="row">
        <span>{w.org} <span class="muted">— {w.role}</span></span>
        <span class="date">{w.dates}</span>
      </li>
    ))}
  </ul>

  <h2>Research</h2>
  <ul class="plain">
    {research.map((r) => (
      <li class="item">
        <div class="row">
          <span>{r.url ? <a href={r.url}>{r.title}</a> : r.title}</span>
          <span class="date">{r.venue} · {r.year}</span>
        </div>
        <p class="muted note">{r.note}</p>
      </li>
    ))}
  </ul>

  <h2>Competitive programming</h2>
  <ul class="plain">
    {competitive.map((c) => <li class="row"><span>{c}</span></li>)}
  </ul>

  <h2>Education</h2>
  <ul class="plain">
    {education.map((e) => (
      <li class="row">
        <span>{e.school} <span class="muted">— {e.degree}</span></span>
        <span class="date">{e.dates}</span>
      </li>
    ))}
  </ul>

  {posts.length > 0 && (
    <>
      <h2>Writing</h2>
      <ul class="plain">
        {posts.map((post) => (
          <li class="row">
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <span class="date">{post.data.draft ? 'draft · ' : ''}{formatDate(post.data.date)}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <footer>
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    {shownLinks.map((l) => <> · <a href={l.url}>{l.label}</a></>)}
  </footer>
</Base>

<style>
  /* Wide screens only: a sticky panel that fills the window height. Hidden below 1100px. */
  .art { display: none; }
  @media (min-width: 1100px) {
    .art {
      display: block;
      position: sticky;
      top: 0;
      /* The images are transparent apart from the beam and Earth, so the panel can run the full
         window height without showing a box. Keeps the image's own shape (--ratio, set inline);
         the text column keeps its 640px and the image gets what's left. */
      height: min(100svh, calc((100vw - 640px - var(--gap) - 2 * var(--pad) - 16px) / var(--ratio)));
      aspect-ratio: var(--ratio);
      /* Own compositing layer, so scrolling moves it as one piece instead of repainting (no jitter). */
      will-change: transform;
      /* Nudged right of its column for a better balance with the text; the text doesn't move. */
      translate: clamp(2rem, 5vw, 6rem) 0;
    }
    .art picture, .art img { display: block; width: 100%; height: 100%; }
    .art img { object-fit: cover; }
    /* Show the version for the current theme; its Earth position drives the ring. */
    .art picture { display: none; }
    :global([data-theme='light']) .art { --earth-x: var(--light-x); --earth-y: var(--light-y); }
    :global([data-theme='dark']) .art { --earth-x: var(--dark-x); --earth-y: var(--dark-y); }
    :global([data-theme='light']) .art picture.light,
    :global([data-theme='dark']) .art picture.dark { display: block; }

    /* A thin ring around Earth with Sagan's line just below it. */
    .earth,
    .earth-note { position: absolute; left: var(--earth-x); translate: -50% 0; }
    .earth {
      top: var(--earth-y);
      width: 22px;
      height: 22px;
      translate: -50% -50%;
      border: 1px solid color-mix(in srgb, var(--text) 55%, transparent);
      border-radius: 50%;
    }
    .earth-note {
      top: calc(var(--earth-y) + 22px);
      width: 80%;
      margin: 0;
      text-align: center;
      font-size: 14px;
      font-style: italic;
      line-height: 1.4;
      color: color-mix(in srgb, var(--text) 75%, transparent);
    }
    .earth-note span { display: block; margin-top: 4px; font-style: normal; font-size: 12px; color: var(--muted); }
  }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .sub { margin: 4px 0 40px; font-size: 16px; }
  .note { margin: 0 0 8px; font-size: 16px; }
  footer { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 16px; color: var(--muted); }
</style>
