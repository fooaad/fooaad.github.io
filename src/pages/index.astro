---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile, intro, interests, work, research, competitive, education, links } from '../data/site';
import { getPosts, formatDate } from '../lib';
import art from '../assets/dhaka-tampa.webp';

const posts = await getPosts();
const shownLinks = links.filter((l) => l.url);
---

<Base>
  <!-- Original file (not recompressed) so the painting stays sharp. Only screens 1100px+ ever download it;
       smaller screens get a 1px placeholder and the panel stays hidden. -->
  <aside slot="aside" class="art" style={`--ratio: ${art.width / art.height}`}>
    <picture>
      <source media="(min-width: 1100px)" srcset={art.src} />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
        width={art.width}
        height={art.height}
        alt="Watercolor of Dhaka's Ahsan Manzil across the river from the Tampa skyline"
      />
    </picture>
  </aside>

  <header>
    <div class="top">
      <h1>{profile.name}</h1>
      <ThemeToggle />
    </div>
    <p class="muted sub">@{profile.handle} · {profile.tagline} · {profile.location}</p>
  </header>

  {intro.map((p) => <p>{p}</p>)}

  <h2>Interests</h2>
  <p>{interests.join(' · ')}</p>

  <h2>Work</h2>
  <ul class="plain">
    {work.map((w) => (
      <li class="row">
        <span>{w.org} <span class="muted">— {w.role}</span></span>
        <span class="date">{w.dates}</span>
      </li>
    ))}
  </ul>

  <h2>Research</h2>
  <ul class="plain">
    {research.map((r) => (
      <li class="item">
        <div class="row">
          <span>{r.url ? <a href={r.url}>{r.title}</a> : r.title}</span>
          <span class="date">{r.venue} · {r.year}</span>
        </div>
        <p class="muted note">{r.note}</p>
      </li>
    ))}
  </ul>

  <h2>Competitive programming</h2>
  <ul class="plain">
    {competitive.map((c) => <li class="row"><span>{c}</span></li>)}
  </ul>

  <h2>Education</h2>
  <ul class="plain">
    {education.map((e) => (
      <li class="row">
        <span>{e.school} <span class="muted">— {e.degree}</span></span>
        <span class="date">{e.dates}</span>
      </li>
    ))}
  </ul>

  {posts.length > 0 && (
    <>
      <h2>Writing</h2>
      <ul class="plain">
        {posts.map((post) => (
          <li class="row">
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <span class="date">{post.data.draft ? 'draft · ' : ''}{formatDate(post.data.date)}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <footer>
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    {shownLinks.map((l) => <> · <a href={l.url}>{l.label}</a></>)}
  </footer>
</Base>

<style>
  /* Wide screens only: a sticky panel that fills the window height. Hidden below 1100px. */
  .art { display: none; }
  @media (min-width: 1100px) {
    .art {
      display: block;
      position: sticky;
      top: var(--pad);
      /* Keep the painting's own shape (--ratio, set inline) so nothing is cropped:
         as tall as the window allows, unless the column is the tighter limit. */
      aspect-ratio: var(--ratio);
      width: min(100%, calc((100svh - 2 * var(--pad)) * var(--ratio)));
      justify-self: end;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
    }
    .art picture, .art img { display: block; width: 100%; height: 100%; }
    .art img { object-fit: cover; }
  }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .sub { margin: 4px 0 40px; font-size: 16px; }
  .note { margin: 0 0 8px; font-size: 16px; }
  footer { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 16px; color: var(--muted); }
</style>
