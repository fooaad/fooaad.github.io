---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile, intro, work, research, competitive, education, links } from '../data/site';
import { getPosts, formatDate } from '../lib';
import art from '../assets/pale-blue-dot.webp';

// Where Earth sits in the cropped photo, as % of width and height (for the marker).
const earth = { x: 50, y: 51.9 };

const posts = await getPosts();
const shownLinks = links.filter((l) => l.url);
---

<Base>
  <!-- Original file (not recompressed) so the image stays sharp. Only screens 1100px+ ever download it;
       smaller screens get a 1px placeholder and the panel stays hidden. -->
  <aside
    slot="aside"
    class="art"
    style={`--ratio: ${art.width / art.height}; --earth-x: ${earth.x}%; --earth-y: ${earth.y}%`}
  >
    <picture>
      <source media="(min-width: 1100px)" srcset={art.src} />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
        width={art.width}
        height={art.height}
        alt="Pale Blue Dot: Earth as a tiny speck in a sunbeam, photographed by Voyager 1 from about 6 billion kilometers away"
      />
    </picture>
    <span class="earth" aria-hidden="true"></span>
    <p class="earth-note">That's here. That's home. That's us.<span>Carl Sagan</span></p>
  </aside>

  <header>
    <div class="top">
      <h1>{profile.name}</h1>
      <ThemeToggle />
    </div>
    <p class="muted sub">@{profile.handle} · {profile.tagline} · {profile.location}</p>
  </header>

  {intro.map((p) => <p>{p}</p>)}

  <h2>Work</h2>
  <ul class="plain">
    {work.map((w) => (
      <li class="row">
        <span>{w.org} <span class="muted">— {w.role}</span></span>
        <span class="date">{w.dates}</span>
      </li>
    ))}
  </ul>

  <h2>Research</h2>
  <ul class="plain">
    {research.map((r) => (
      <li class="item">
        <div class="row">
          <span>{r.url ? <a href={r.url}>{r.title}</a> : r.title}</span>
          <span class="date">{r.venue} · {r.year}</span>
        </div>
        <p class="muted note">{r.note}</p>
      </li>
    ))}
  </ul>

  <h2>Competitive programming</h2>
  <ul class="plain">
    {competitive.map((c) => <li class="row"><span>{c}</span></li>)}
  </ul>

  <h2>Education</h2>
  <ul class="plain">
    {education.map((e) => (
      <li class="row">
        <span>{e.school} <span class="muted">— {e.degree}</span></span>
        <span class="date">{e.dates}</span>
      </li>
    ))}
  </ul>

  {posts.length > 0 && (
    <>
      <h2>Writing</h2>
      <ul class="plain">
        {posts.map((post) => (
          <li class="row">
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <span class="date">{post.data.draft ? 'draft · ' : ''}{formatDate(post.data.date)}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <footer>
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    {shownLinks.map((l) => <> · <a href={l.url}>{l.label}</a></>)}
    <p class="credit">Image: <a href="https://science.nasa.gov/photojournal/pale-blue-dot-revisited">Pale Blue Dot Revisited</a>, Voyager 1 · NASA/JPL-Caltech</p>
  </footer>
</Base>

<style>
  /* Wide screens only: a sticky panel that fills the window height. Hidden below 1100px. */
  .art { display: none; }
  @media (min-width: 1100px) {
    .art {
      display: block;
      position: sticky;
      top: var(--pad);
      /* Full window height at the image's own shape (--ratio, set inline), so nothing is cropped.
         The text column keeps its full 640px; in narrower windows the image gets what's left. */
      height: min(
        calc(100svh - 2 * var(--pad)),
        calc((100vw - 640px - var(--gap) - 2 * var(--pad) - 16px) / var(--ratio))
      );
      aspect-ratio: var(--ratio);
      /* No frame: the photo fades into the page on every side, so it blends with either theme. */
      mask-image:
        linear-gradient(to right, transparent, #000 18%, #000 82%, transparent),
        linear-gradient(to bottom, transparent, #000 12%, #000 60%, transparent);
      mask-composite: intersect;
    }
    .art picture, .art img { display: block; width: 100%; height: 100%; }
    .art img { object-fit: cover; }
    /* Light mode: a negative of the same photo, pale sky with Earth as a dark speck. */
    :global([data-theme='light']) .art img { filter: invert(1) hue-rotate(180deg) brightness(1.08) contrast(0.85); }

    /* A thin ring around Earth with Sagan's line just below it. */
    .earth,
    .earth-note { position: absolute; left: var(--earth-x); translate: -50% 0; }
    .earth {
      top: var(--earth-y);
      width: 22px;
      height: 22px;
      translate: -50% -50%;
      border: 1px solid color-mix(in srgb, var(--text) 55%, transparent);
      border-radius: 50%;
    }
    .earth-note {
      top: calc(var(--earth-y) + 22px);
      width: 80%;
      margin: 0;
      text-align: center;
      font-size: 14px;
      font-style: italic;
      line-height: 1.4;
      color: color-mix(in srgb, var(--text) 75%, transparent);
    }
    .earth-note span { display: block; margin-top: 4px; font-style: normal; font-size: 12px; color: var(--muted); }
  }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .sub { margin: 4px 0 40px; font-size: 16px; }
  .note { margin: 0 0 8px; font-size: 16px; }
  .credit { margin: 12px 0 0; font-size: 14px; }
  footer { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 16px; color: var(--muted); }
</style>
