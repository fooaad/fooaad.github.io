<button class="theme" type="button" aria-label="Toggle dark mode">
  <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
</button>

<style>
  .theme {
    background: none;
    border: 0;
    padding: 6px;
    margin: -6px;
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
  }
  .theme:hover { color: var(--text); }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='light']) .moon { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.theme').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });
  });
</script>
