---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = `${profile.fullName} (${profile.name}) — ${profile.tagline}.`, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.fullName} (${profile.name})`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Link preview card (LinkedIn, X, Slack, iMessage); regenerate public/og.png if the name or tagline changes. -->
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta property="og:url" content={canonical} />
        <link rel="canonical" href={canonical} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}'s writing`} href="/rss.xml" />
    <script is:inline>
      // Set the theme before paint: the visitor's saved choice, else dark.
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <slot name="aside" />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
